}
*/

void VGA_limpiarNumero(u8 origenRow, u8 origenCol){

	for(u8 f = 0; f < 7; f++){
		VGA_pintar(origenRow - f, origenCol, 0);
		VGA_pintar(origenRow - f, origenCol + 1, 0);
		VGA_pintar(origenRow - f, origenCol + 2, 0);
		VGA_pintar(origenRow - f, origenCol + 3, 0);
	}
}


