}

tEstado estado_ESPERA(){

}

tEstado estado_GANAR(){

}

tEstado estado_PERDER(){

}

void operacionesEstadoActual(){

	switch(ESTADO_ACTUAL){
	case STATE_MENU:
		MATRIZ_escribirEstado(TEXTO_MENU);
		break;

	case STATE_AJUSTES:
		MATRIZ_escribirEstado(TEXTO_AJUSTES);
		break;

	case STATE_COLOR:
		MATRIZ_escribirEstado(TEXTO_COLOR);
		break;

	case STATE_SALDO:
		MATRIZ_escribirEstado(TEXTO_SALDO);
		break;

	case STATE_JUGAR:
		MATRIZ_escribirEstado(TEXTO_JUGAR);
		break;

	case STATE_NUMERO:
		MATRIZ_escribirEstado(TEXTO_NUMERO);
		break;

	case STATE_ESPERA:
		MATRIZ_escribirEstado(TEXTO_RULETA);
		break;

	case STATE_GANAR:
		MATRIZ_escribirEstado(TEXTO_WINNER);
		break;

	case STATE_PERDER:
		MATRIZ_escribirEstado(TEXTO_LOSER);
		break;

	default:
		break;
	}

}

tEstado obtenerSiguienteEstado(){

	tEstado siguiente;

	switch(ESTADO_ACTUAL){
	case STATE_MENU:
		siguiente = estado_MENU();
		break;

	case STATE_AJUSTES:
		siguiente = estado_AJUSTES();
		break;

	case STATE_COLOR:
		siguiente = estado_COLOR();
		break;

	case STATE_SALDO:
		siguiente = estado_SALDO();
		break;

	case STATE_JUGAR:
		siguiente = estado_JUGAR();
		break;

	case STATE_NUMERO:
		siguiente = estado_NUMERO();
		break;

	case STATE_ESPERA:
		siguiente = estado_ESPERA();
		break;

	case STATE_GANAR:
		siguiente = estado_GANAR();
		break;

	case STATE_PERDER:
		siguiente = estado_PERDER();
		break;

	case STATE_EXIT:
	default:
		siguiente = STATE_EXIT;
		break;
	}

	return siguiente;
}


int main() {

	Xil_ICacheEnable();
	Xil_DCacheEnable();

	// Inicializar todos los componentes y definir estado inicial
	inicializar();
	ESTADO_ACTUAL = STATE_MENU;
	ESTADO_SIGUIENTE = ESTADO_ACTUAL;

	while(ESTADO_ACTUAL != STATE_EXIT){

		// Operaciones segun el estado actual
		operacionesEstadoActual();

		// Obtener siguiente estado
		ESTADO_SIGUIENTE = obtenerSiguienteEstado();

		// Pasar siguiente estado
		ESTADO_ACTUAL = ESTADO_SIGUIENTE;
	}

	Xil_DCacheDisable();
	Xil_ICacheDisable();
	return 0;
}
