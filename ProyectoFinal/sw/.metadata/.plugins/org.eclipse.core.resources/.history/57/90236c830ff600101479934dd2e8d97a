// ---------------------- MATRIZ DE PUNTOS ----------------------
#include "matriz.h"
#define NUM_ROWS 7
#define NUM_COLS 8
#define MATRIZ_ADDR XPAR_MATRIZ_0_S00_AXI_BASEADDR
#define MATRIZ_REG0 MATRIZ_S00_AXI_SLV_REG0_OFFSET

// Constantes para definir los valores de una fila
// O = Apagado
// T = Encendido
#define OOOOO 0
#define OOOOT 1
#define OOOTO 2
#define OOOTT 3
#define OOTOO 4
#define OOTOT 5
#define OOTTO 6
#define OOTTT 7
#define OTOOO 8
#define OTOOT 9
#define OTOTO 10
