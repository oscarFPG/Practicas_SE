		LED_mWriteReg(LED0_ADDR, RED_CHANNEL, LED_UP);
		break;

	case GREEN:
		LED_mWriteReg(LED0_ADDR, GREEN_CHANNEL, LED_UP);
		break;

	case BLUE:
		LED_mWriteReg(LED0_ADDR, BLUE_CHANNEL, LED_UP);
		break;

	default:
		break;
	}
}

void LED_apagar(int canal) {

	switch (canal) {
	case RED:
		LED_mWriteReg(LED0_ADDR, RED_CHANNEL, LED_DOWN);
		break;

	case GREEN:
		LED_mWriteReg(LED0_ADDR, GREEN_CHANNEL, LED_DOWN);
		break;

	case BLUE:
		LED_mWriteReg(LED0_ADDR, BLUE_CHANNEL, LED_DOWN);
		break;

	default:
		break;
	}
}


/* -------------------------- PROYECTO -------------------------- */
typedef enum {
	STATE_MENU,		// Menu principal
	STATE_CONFIG,	// Configuracion
	STATE_COLOR,	// Modificar color
	STATE_SALDO,	// Modificar saldo
	STATE_RULETA,	// Menu ruleta
	STATE_GANAR,	// Jugador gana apuesta
	STATE_PERDER,	// Jugador pierdde apuesta
	STATE_EXIT		// Jugador sale de la aplicacion
} tEstado;


void inicializar(){

	MATRIZ_apagar();

	LED_apagar(RED);
	LED_apagar(GREEN);
	LED_apagar(BLUE);

	VGA_apagar();
}


tEstado obtenerSiguienteEstado(tEstado* actual){

	tEstado siguiente = STATE_EXIT;

	return siguiente;
}


int main() {

	Xil_ICacheEnable();
	Xil_DCacheEnable();

	inicializar();

	while(1){
		MATRIZ_escribir_ANIADIR();
		//MATRIZ_escribir_WINNER();
		//MATRIZ_escribir_LOSER();
		sleep(10);
	}


	tEstado estadoActual = STATE_MENU;
	tEstado estadoSiguiente = estadoActual;

	while(estadoActual != STATE_EXIT){

		// Obtener siguiente estado
		estadoSiguiente = obtenerSiguienteEstado(&estadoActual);

		// Pasar siguiente estado
		estadoActual = estadoSiguiente;
	}

	Xil_DCacheDisable();
	Xil_ICacheDisable();
	return 0;
}
