#include <stdio.h>
#include "xparameters.h"
#include "xil_cache.h"
#include "copro.h"


int main () {

   Xil_ICacheEnable();
   Xil_DCacheEnable();
   print("---Entering main---\n\r");

   COPRO_mWriteReg(XPAR_COPRO_0_S00_AXI_BASEADDR, COPRO_S00_AXI_SLV_REG1_OFFSET, 10);
   COPRO_mWriteReg(XPAR_COPRO_0_S00_AXI_BASEADDR, COPRO_S00_AXI_SLV_REG2_OFFSET, 4);

   while(1){

	   COPRO_mReadReg(XPAR_COPRO_0_S00_AXI_BASEADDR, COPRO_S00_AXI_SLV_REG3_OFFSET);
   }


   print("---Exiting main---\n\r");
   Xil_DCacheDisable();
   Xil_ICacheDisable();
   return 0;
}
