#include <stdio.h>
#include "xparameters.h"
#include "xil_cache.h"
#include "xil_io.h"
#include "xil_types.h"

#include "LEDs.h"
#include "Keypad.h"

#define NO_TECLA 0x11FF


void menu_Keypad(){

	xil_printf("Esperando tecla del keypad...\n\r");

	int8_t caracter = NO_TECLA;
	while(caracter == NO_TECLA){
		caracter = KEYPAD_mReadReg(XPAR_KEYPAD_0_S00_AXI_BASEADDR, KEYPAD_S00_AXI_SLV_REG0_OFFSET);
	}

	xil_printf("Caracter leido %c\n\r", carater);
}

